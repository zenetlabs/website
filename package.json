{
  "name": "zenetlabs-website",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:clear-bookings:local": "wrangler d1 execute DB --local --command \"DELETE FROM bookings\"",
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.workers.json",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check:i18n": "vitest run src/i18n/catalogues.test.ts",
    "check:colors": "vitest run src/styles/hardcoded-colors.test.ts",
    "e2e": "playwright test",
    "lhci": "pnpm lhci:mobile; mobile=$?; pnpm lhci:desktop; desktop=$?; exit $((mobile | desktop))",
    "lhci:mobile": "lhci healthcheck --fatal && lhci collect && lhci upload --target=filesystem --outputDir=lhci-reports/mobile && lhci assert",
    "lhci:desktop": "lhci healthcheck --fatal && lhci collect --settings.preset=desktop && lhci upload --target=filesystem --outputDir=lhci-reports/desktop && lhci assert",
    "voice:plan": "node scripts/voice-agent.mjs plan",
    "voice:apply": "node scripts/voice-agent.mjs apply",
    "knip": "knip",
    "doctor": "react-doctor"
  },
  "dependencies": {
    "@elevenlabs/client": "1.32.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@marsidev/react-turnstile": "1.6.2",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-start": "1.168.61",
    "ai": "7.0.158",
    "jose": "6.2.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "workers-ai-provider": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "5.20261011.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "happy-dom": "21.0.4",
    "knip": "6.41.0",
    "playwright-core": "1.64.0",
    "react-doctor": "0.9.17",
    "schema-dts": "2.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
