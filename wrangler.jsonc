{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "local-zenet-web",
  "account_id": "a77225fbdf7bcff161325563e9c2063b",
  "main": "./src/server.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "secrets_store_secrets": [
    {
      "binding": "RESEND_API_KEY",
      "store_id": "5a96b366abb34e3991c881dab187adfd",
      "secret_name": "PROD_RESEND_API_KEY"
    },
    {
      "binding": "TURNSTILE_SECRET_KEY",
      "store_id": "5a96b366abb34e3991c881dab187adfd",
      "secret_name": "ZENETLABS_PROD_TURNSTILE_SECRET"
    },
    {
      "binding": "GOOGLE_CALENDAR",
      "store_id": "5a96b366abb34e3991c881dab187adfd",
      "secret_name": "ZENETLABS_PROD_GOOGLE_CALENDAR"
    },
    {
      "binding": "TOOLS_BEARER_SECRET",
      "store_id": "5a96b366abb34e3991c881dab187adfd",
      "secret_name": "ZENETLABS_PROD_ELEVENLABS_TOOL_SECRET"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "local-zenet-web",
      "database_id": "local-zenet-web",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "LEAD_LIMITER",
      "namespace_id": "7301",
      "simple": { "limit": 100, "period": 60 }
    },
    {
      "name": "TOOLS_LIMITER",
      "namespace_id": "7302",
      "simple": { "limit": 1000, "period": 60 }
    },
    {
      "name": "BOOK_LIMITER",
      "namespace_id": "7303",
      "simple": { "limit": 100, "period": 60 }
    },
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "7304",
      "simple": { "limit": 100, "period": 60 }
    }
  ],
  "env": {
    "production": {
      "name": "prod-zenet-web",
      "preview_urls": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "prod-zenet-web",
          "database_id": "c0d356ee-e64a-469d-b076-78ab56473aa4",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        {
          "name": "LEAD_LIMITER",
          "namespace_id": "7301",
          "simple": { "limit": 5, "period": 60 }
        },
        {
          "name": "TOOLS_LIMITER",
          "namespace_id": "7302",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "BOOK_LIMITER",
          "namespace_id": "7303",
          "simple": { "limit": 5, "period": 60 }
        },
        {
          "name": "CHAT_LIMITER",
          "namespace_id": "7304",
          "simple": { "limit": 10, "period": 60 }
        }
      ],
      "ai": { "binding": "AI" },
      "triggers": { "crons": ["*/10 * * * *"] },
      "secrets_store_secrets": [
        {
          "binding": "RESEND_API_KEY",
          "store_id": "5a96b366abb34e3991c881dab187adfd",
          "secret_name": "PROD_RESEND_API_KEY"
        },
        {
          "binding": "TURNSTILE_SECRET_KEY",
          "store_id": "5a96b366abb34e3991c881dab187adfd",
          "secret_name": "ZENETLABS_PROD_TURNSTILE_SECRET"
        },
        {
          "binding": "GOOGLE_CALENDAR",
          "store_id": "5a96b366abb34e3991c881dab187adfd",
          "secret_name": "ZENETLABS_PROD_GOOGLE_CALENDAR"
        },
        {
          "binding": "TOOLS_BEARER_SECRET",
          "store_id": "5a96b366abb34e3991c881dab187adfd",
          "secret_name": "ZENETLABS_PROD_ELEVENLABS_TOOL_SECRET"
        }
      ],
      "routes": [
        { "pattern": "zenetlabs.com", "custom_domain": true },
        { "pattern": "www.zenetlabs.com", "custom_domain": true },
        { "pattern": "zenettech.com", "custom_domain": true },
        { "pattern": "www.zenettech.com", "custom_domain": true },
        { "pattern": "zenettechnology.com", "custom_domain": true },
        { "pattern": "www.zenettechnology.com", "custom_domain": true },
        { "pattern": "sabatemartinez.com", "custom_domain": true },
        { "pattern": "www.sabatemartinez.com", "custom_domain": true }
      ]
    }
  }
}
